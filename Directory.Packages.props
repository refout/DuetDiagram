<Project>

  <!--
    方案 2. 技术选型 — 版本锁定：全部精确版本，不允许通配。
    Phase 0 P0-01 验收：本文件不得出现 '*' 或区间版本。

    已核实（2026-09-20，nuget.azure.cn）：本文件里出现的每个版本都真实存在。

    注意：布局引擎最终采用 Mostlylucid.Dagre 而不是 Mermaider 依赖的 Sugiyama，
    理由与并排数据见 reports/phase0a-layout.md。

    **登记项必须有人用。** 这里只登记被工程真正引用的包；
    验证阶段核实过存在但最终没选上的，删掉登记而不是留着"以防万一"。
    留着的代价不是占几行，而是让"有哪些依赖"这个问题失去准确答案——
    我们连 Mermaider 是布局库还是解析器都判断错过一次。

    按这条规则，下面每一项都有一处真实的引用：清单里没有"将来可能要用"的条目。
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Phase 0a 依赖验证">
    <!-- 界面框架与其平台后端。后端包负责把窗口和输入接到具体操作系统上。 -->
    <PackageVersion Include="Avalonia" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.2" />

    <!-- 绘图与文本排版。图形由界面框架自己的绘制上下文完成，文本测量与整形直接用它。 -->
    <PackageVersion Include="SkiaSharp" Version="4.148.0" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Win32" Version="4.148.0" />
    <!--
      Linux 那一份原生库不在 SkiaSharp 包里：那个包的清单只带 Win32 与 macOS 两份，
      Linux 要单独引。缺了它的表现是「Windows 上一切正常，Linux 上一碰 SkiaSharp 就
      DllNotFoundException」——位图导出、PDF 导出与文本测量三条路都走不通。
    -->
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="4.148.0" />

    <!--
      备选布局引擎，也是最终选中的那个。它的调用方式有讲究：
      必须用索引式入口，默认入口在千节点上要慢几十倍，见 docs/Layout-Constraints.md。
    -->
    <PackageVersion Include="Mostlylucid.Dagre" Version="2.0.1" />

    <!--
      引擎选型取证用的对照实现。只在 tools/Poc/LayoutCandidates 里引用，
      不进产品——它当初被否掉的理由见 reports/phase0a-layout.md。
    -->
    <PackageVersion Include="Sugiyama" Version="0.12.2" />

    <!--
      PDF 写入候选，只在 tools/Poc/PdfCandidates 里引用，不进产品。
      两个都没选上，理由见 reports/phase4-pdf.md：一个是画布接口已废弃且会抛异常，
      一个是逐字节不确定而且不认字体集合。最终用的是 SkiaSharp 自带的写入器，
      因此这里没有多出一个产品依赖。
    -->
    <PackageVersion Include="QuestPDF" Version="2026.9.0" />
    <PackageVersion Include="PdfSharpCore" Version="1.3.67" />

    <!-- 外部代理接入：官方 MCP 实现，分核心包、宿主集成包与网络框架集成包三层。 -->
    <PackageVersion Include="ModelContextProtocol" Version="2.2.0" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />

    <!--
      内部模型集成。MCP 的工具类型与它共用同一套函数抽象，
      因此一份工具定义同时供内部模型与外部代理使用——这件事已经落地，
      落点是把模型侧的函数交给代理侧派生工具。
    -->
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.7.0" />

    <!-- 性能测量。关键路径用统计方法测，不靠单次计时的秒表读数据。 -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <ItemGroup Label="Test stack">
    <!-- xunit.v3 自带 Microsoft.Testing.Platform runner，无需 VSTest 桥接包。 -->
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <!--
      FluentAssertions 8.x 起改为商业许可（Xceed）。7.2.2 是最后一个 Apache-2.0 版本，
      公开 API 与 8.x 基本一致，升级只需改版本号。若确定已购授权可改为 8.11.0。
    -->
    <PackageVersion Include="FluentAssertions" Version="7.2.2" />

    <!--
      无头界面测试。它把界面框架的平台后端换成一个不画到屏幕上的实现，
      端到端测试因此能在没有显示器的机器上起窗口、送输入、抓一帧。
      没有用配套的 XUnit 集成包：那个包绑的是低一个大版本的测试框架，
      与这里现有的 xunit.v3 对不上，装上之后在发现阶段就抛"找不到方法"。
      会话本身只有几十行，直接用反而少一处会随版本漂移的依赖。
    -->
    <PackageVersion Include="Avalonia.Headless" Version="12.1.2" />
  </ItemGroup>

</Project>
