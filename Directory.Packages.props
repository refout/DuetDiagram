<Project>

  <!--
    方案 2. 技术选型 — 版本锁定：全部精确版本，不允许通配。
    Phase 0 P0-01 验收：本文件不得出现 '*' 或区间版本。

    已核实（2026-09-20，nuget.azure.cn）：本文件里出现的每个版本都真实存在，
    包括下列主选依赖：
      Avalonia                12.1.2   exists
      SkiaSharp               4.148.0  exists (stable)
      Microsoft.Extensions.AI 10.7.0   exists
      ModelContextProtocol    2.2.0    exists
      Mermaider               0.12.2   exists
      Mostlylucid.Dagre       2.0.1    exists

    仍待引入的包（用到时再登记，不要提前加）：
      Microsoft.Extensions.AI / ModelContextProtocol → 外部代理接入阶段

    注意：布局引擎最终采用 Mostlylucid.Dagre 而不是 Mermaider 依赖的 Sugiyama，
    理由与并排数据见 reports/phase0a-layout.md。
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Phase 0a 依赖验证">
    <!-- 界面框架与其平台后端。后端包负责把窗口和输入接到具体操作系统上。 -->
    <PackageVersion Include="Avalonia" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.2" />

    <!-- 绘图与文本排版。图形由界面框架自己的绘制上下文完成，文本测量与整形直接用它。 -->
    <PackageVersion Include="SkiaSharp" Version="4.148.0" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Win32" Version="4.148.0" />

    <!-- Mermaid 渲染器，以及它依赖的分层图布局引擎（单独成包，可以脱离 Mermaid 独立使用）。 -->
    <PackageVersion Include="Mermaider" Version="0.12.2" />
    <PackageVersion Include="Sugiyama" Version="0.12.2" />

    <!-- 备选布局引擎：分层布局的另一个实现，自述对原生编译友好且支持复合图。 -->
    <PackageVersion Include="Mostlylucid.Dagre" Version="2.0.1" />

    <!-- 外部代理接入：官方 MCP 实现，分核心包、宿主集成包与网络框架集成包三层。 -->
    <PackageVersion Include="ModelContextProtocol" Version="2.2.0" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />

    <!--
      内部模型集成。MCP 的工具类型与它共用同一套函数抽象，
      因此一份工具定义有可能同时供内部模型与外部代理使用。
    -->
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.7.0" />

    <!--
      宿主与日志的具体实现。MCP 的宿主集成包只依赖宿主的抽象层，
      因此不引用网络框架的宿主需要自己引入这两个包。
      版本与 MCP 包声明的一致，避免两套抽象层版本混用。
    -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup Label="Test stack">
    <!-- xunit.v3 自带 Microsoft.Testing.Platform runner，无需 VSTest 桥接包。 -->
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <!--
      FluentAssertions 8.x 起改为商业许可（Xceed）。7.2.2 是最后一个 Apache-2.0 版本，
      公开 API 与 8.x 基本一致，升级只需改版本号。若确定已购授权可改为 8.11.0。
    -->
    <PackageVersion Include="FluentAssertions" Version="7.2.2" />
  </ItemGroup>

</Project>
