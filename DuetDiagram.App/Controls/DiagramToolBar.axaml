<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DuetDiagram.App.Controls.DiagramToolBar">
  <!--
    按钮在代码里按注册表搭出来（见 .axaml.cs）。这一层只给一个会折行的容器：
    档与档之间那条竖线也是代码加的，因为档的条数取决于注册表。
    不排成一行而是折行：按钮的条数由注册表定，窗口窄一点就有一截跑到可视区外面，
    而那些按钮既点不到、也没有任何迹象说明它们存在。折行之后窗口再窄也只是多占一行。
  -->
  <WrapPanel Name="Body"
             Orientation="Horizontal"
             ItemSpacing="8"
             LineSpacing="6"
             Margin="8,6" />
</UserControl>
