<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DuetDiagram.App.Controls.ImportDialog"
             xmlns:res="using:DuetDiagram.App.Resources">
  <!--
    一次导入或一次打开之后摆出来的那张单子：动了哪个文件、结果是什么、以及哪些地方与原文对不上。
    它只是一个报告面板，不认识会话也不认识文档——导不导、开不开、完事怎么办都由宿主去办。
  -->
  <Border Padding="14"
          Width="420"
          Background="#f6f8fb"
          BorderBrush="#8fa3bd"
          BorderThickness="1"
          CornerRadius="6">
    <StackPanel>
      <TextBlock x:Name="TitleText"
                 FontSize="13"
                 FontWeight="SemiBold"
                 Foreground="#2b3a4d"
                 Text="{x:Static res:Strings.ImportTitle}" />
      <TextBlock x:Name="FileText"
                 Margin="0,6,0,0"
                 FontSize="12"
                 FontWeight="SemiBold"
                 Foreground="#2b3a4d"
                 TextWrapping="Wrap"
                 Text="" />
      <TextBlock x:Name="HeadlineText"
                 Margin="0,4,0,0"
                 FontSize="12"
                 Foreground="#5b6675"
                 TextWrapping="Wrap"
                 Text="" />

      <!--
        诊断与取舍逐条列出来。空着的时候整块收起来——一份干净的内容导进来
        不该留一个空框，那看起来像"本来有话要说但没显示出来"。
      -->
      <ScrollViewer x:Name="NotesScroll"
                    Margin="0,8,0,0"
                    MaxHeight="200"
                    HorizontalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="NotesList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Margin="0,2"
                         FontSize="12"
                         Foreground="#7a4a12"
                         TextWrapping="Wrap"
                         Text="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <StackPanel Margin="0,10,0,0"
                  Orientation="Horizontal"
                  Spacing="8">
        <Button x:Name="CloseButton"
                AutomationProperties.Name="关闭报告"
                Content="{x:Static res:Strings.ImportClose}" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
