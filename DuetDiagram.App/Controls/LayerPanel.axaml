<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DuetDiagram.App.ViewModels"
             x:Class="DuetDiagram.App.Controls.LayerPanel"
             x:DataType="vm:LayerPanelViewModel">

  <!--
    分栏而不是浮层。图层面板是界面上固定的六个分区之一，所以它与属性面板一样占一栏；
    浮层的代价是开关一次会改画布尺寸，而画布一改尺寸视口就跟着变——
    诊断面板与变更边栏正是为这条才做成浮层的，这里没有那个必要。
  -->
  <Border Background="#fbfcfd"
          BorderBrush="#d8dee7"
          BorderThickness="0,0,1,0">
    <DockPanel Margin="12,10">

      <TextBlock DockPanel.Dock="Top"
                 FontSize="13"
                 FontWeight="SemiBold"
                 Foreground="#2b3440"
                 Text="图层" />

      <!--
        改不动时先把原因写在列表之前。开关全灰着而不说一句的话，
        用户会以为面板坏了，而不是想到"另一个进程正开着这份文档"。
      -->
      <TextBlock DockPanel.Dock="Top"
                 Margin="0,6,0,0"
                 FontSize="11"
                 Foreground="#8a6d1f"
                 TextWrapping="Wrap"
                 Text="{Binding ReadOnlyNote}"
                 IsVisible="{Binding HasReadOnlyNote}" />

      <!-- 一个图层都没有时给一句怎么理解，顺便说明缺省层是什么。 -->
      <TextBlock DockPanel.Dock="Top"
                 Margin="0,8,0,0"
                 FontSize="12"
                 Foreground="#7a8492"
                 TextWrapping="Wrap"
                 Text="{Binding EmptyHint}"
                 IsVisible="{Binding HasEmptyHint}" />

      <StackPanel x:Name="Footer"
                  DockPanel.Dock="Bottom"
                  Margin="0,10,0,0"
                  Spacing="6" />

      <ScrollViewer Margin="0,8,0,0"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="Rows" Spacing="2" />
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
