<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DuetDiagram.App.Controls.LayoutFailureDialog"
             xmlns:res="using:DuetDiagram.App.Resources">
  <!--
    布局彻底失败时浮出来的提示。三个选项：重试、手动布局、简化图。
    画面不清空——保留上一次成功的布局，清空会让用户以为图丢了。
  -->
  <Border Padding="14"
          Width="380"
          Background="#fff5f6"
          BorderBrush="#c4314b"
          BorderThickness="1"
          CornerRadius="6">
    <StackPanel>
      <TextBlock FontSize="13"
                 FontWeight="SemiBold"
                 Foreground="#c4314b"
                 Text="{x:Static res:Strings.LayoutFailureTitle}" />
      <TextBlock x:Name="DetailText"
                 Margin="0,6,0,0"
                 FontSize="12"
                 Foreground="#5b6675"
                 TextWrapping="Wrap"
                 Text="" />
      <StackPanel Margin="0,10,0,0"
                  Orientation="Horizontal"
                  Spacing="8">
        <Button x:Name="RetryButton"
                AutomationProperties.Name="重试布局"
                Content="{x:Static res:Strings.LayoutFailureRetry}" />
        <Button x:Name="ManualButton"
                AutomationProperties.Name="改为手动摆放"
                Content="{x:Static res:Strings.LayoutFailureManual}" />
        <Button x:Name="SimplifyButton"
                AutomationProperties.Name="简化这张图"
                Content="{x:Static res:Strings.LayoutFailureSimplify}" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
