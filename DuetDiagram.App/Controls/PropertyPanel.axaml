<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DuetDiagram.App.ViewModels"
             x:Class="DuetDiagram.App.Controls.PropertyPanel"
             x:DataType="vm:PropertyPanelViewModel">

  <!--
    分栏而不是浮层。属性面板要能滚动着看几十个字段，浮层会挡住画布；
    而画布那边真正需要浮层的只有诊断数字，它在自己的控件里。
  -->
  <Border Background="#fbfcfd"
          BorderBrush="#d8dee7"
          BorderThickness="1,0,0,0">
    <DockPanel Margin="12,10">

      <TextBlock DockPanel.Dock="Top"
                 FontSize="13"
                 FontWeight="SemiBold"
                 Foreground="#2b3440"
                 TextTrimming="CharacterEllipsis"
                 Text="{Binding Title}" />

      <!--
        改不动时先把原因写在字段之前。字段全灰着而不说一句的话，
        用户会以为面板坏了，而不是想到"另一个进程正开着这份文档"。
      -->
      <TextBlock DockPanel.Dock="Top"
                 Margin="0,6,0,0"
                 FontSize="11"
                 Foreground="#8a6d1f"
                 TextWrapping="Wrap"
                 Text="{Binding ReadOnlyNote}"
                 IsVisible="{Binding HasReadOnlyNote}" />

      <!--
        多选时的说明。多选下改一个字段等于给每个选中元素赋同一个值，
        这件事必须写出来——不写的话用户以为改的只是当前那个，等发现时
        原来的值已经找不回来了。
      -->
      <TextBlock DockPanel.Dock="Top"
                 Margin="0,4,0,0"
                 FontSize="11"
                 Foreground="#7a8492"
                 TextWrapping="Wrap"
                 Text="{Binding SelectionNote}"
                 IsVisible="{Binding HasSelectionNote}" />

      <!-- 没选中时给一句怎么开始，而不是一片空白——空白看起来像面板坏了。 -->
      <TextBlock DockPanel.Dock="Top"
                 Margin="0,8,0,0"
                 FontSize="12"
                 Foreground="#7a8492"
                 TextWrapping="Wrap"
                 Text="在画布上点一个节点，这里显示它的属性。按住 Ctrl 或 Shift 点可以多选。"
                 IsVisible="{Binding !HasSelection}" />

      <ScrollViewer Margin="0,10,0,0"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="Body" Spacing="14" />
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
