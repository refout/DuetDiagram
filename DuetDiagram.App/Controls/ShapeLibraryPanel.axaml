<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DuetDiagram.App.ViewModels"
             x:Class="DuetDiagram.App.Controls.ShapeLibraryPanel"
             x:DataType="vm:ShapeLibraryPanelViewModel">

  <!--
    与左栏另外三个面板同一条布局口径：常驻分栏，不做成浮层——浮层的开关会改画布尺寸，
    而画布一改尺寸视口就跟着跳。
  -->
  <Border Background="#fbfcfd"
          BorderBrush="#d8dee7"
          BorderThickness="0,0,1,0">
    <DockPanel Margin="12,10">

      <TextBlock DockPanel.Dock="Top"
                 FontSize="13"
                 FontWeight="SemiBold"
                 Foreground="#2b3440"
                 Text="形状" />

      <TextBlock DockPanel.Dock="Top"
                 Margin="0,6,0,0"
                 FontSize="11"
                 Foreground="#8a6d1f"
                 TextWrapping="Wrap"
                 Text="{Binding ReadOnlyNote}"
                 IsVisible="{Binding HasReadOnlyNote}" />

      <TextBlock x:Name="ErrorText"
                 DockPanel.Dock="Top"
                 Margin="0,6,0,0"
                 FontSize="11"
                 Foreground="#a13c3c"
                 TextWrapping="Wrap" />

      <ScrollViewer Margin="0,8,0,0"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <WrapPanel x:Name="Rows" />
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
