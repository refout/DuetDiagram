<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>DuetDiagram.App</RootNamespace>

    <!--
      界面框架用编译期绑定而不是运行时反射解析界面标记，
      这样才能在裁剪与原生编译之后仍然找到界面元素。
    -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <!--
      开启原生编译。界面框架本身对这条路径有支持，但真实可行性正是本项目要验证的内容：
      任何一处退回运行时反射的用法都会在发布阶段或首次运行暴露出来。
    -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" />
  </ItemGroup>

  <!--
    画布只消费绘制列表，所以它需要渲染层把文档翻译成绘制指令的那一段。
    布局与核心是渲染层的传递依赖，显式写出来是因为主程序自己也要用：
    示例文档要造 IR，还要跑一次布局才有坐标可画。
  -->
  <ItemGroup>
    <ProjectReference Include="..\DuetDiagram.Core\DuetDiagram.Core.csproj" />
    <ProjectReference Include="..\DuetDiagram.Layout\DuetDiagram.Layout.csproj" />
    <ProjectReference Include="..\DuetDiagram.Render\DuetDiagram.Render.csproj" />
  </ItemGroup>

  <!--
    模板文件要显式声明跟着构建输出走。不声明的话开发机上一切正常（跑的是源码目录），
    发布之后模板列表是空的，而那种空看起来像"这一轮没做"。
    写成 Content 而不是嵌入资源：模板是给人看的、可手改的文件，嵌入之后改一个要重新编译，
    而 AOT 下按名字取嵌入资源还要多一层约定。
  -->
  <ItemGroup>
    <Content Include="Templates\*.template.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
