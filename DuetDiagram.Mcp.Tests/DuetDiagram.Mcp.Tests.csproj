<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsAotCompatible>false</IsAotCompatible>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="FluentAssertions" />
  </ItemGroup>

  <ItemGroup>
    <!--
      网络那一档的用例要在一个真端口上起服务端，再连上去调工具。
      网络框架与它的测试主机都来自共享框架，不走 NuGet。
    -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!--
      引用服务端工程：这些用例要把它作为子进程拉起来。
      工程引用还保证它先于测试被编译出来，用例不必自己去触发一次编译。
    -->
    <ProjectReference Include="..\DuetDiagram.Mcp\DuetDiagram.Mcp.csproj" />
    <ProjectReference Include="..\DuetDiagram.Core\DuetDiagram.Core.csproj" />

    <!--
      语法那一层的资源文件里的例子要拿真的解析器跑一遍。引用 DSL 工程是为了这个：
      自己写一个"看起来对"的校验等于什么都没验，而文档里的例子过期了不会报错，
      只会让模型照着写错的东西。
    -->
    <ProjectReference Include="..\DuetDiagram.Dsl\DuetDiagram.Dsl.csproj" />
  </ItemGroup>

</Project>
