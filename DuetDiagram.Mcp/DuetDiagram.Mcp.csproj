<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--
      宿主与协议实现都要用反射去建服务与反序列化协议消息，原生编译分析器看不出来，
      而这一层的目标也不是发布成原生可执行文件：它作为子进程跑在本机。
    -->
    <IsAotCompatible>false</IsAotCompatible>
    <EnableAotAnalyzer>false</EnableAotAnalyzer>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DuetDiagram.Llm\DuetDiagram.Llm.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      协议实现分三层：核心包、宿主集成包与网络框架集成包。
      标准输入输出那条传输只用得上核心包，网络那条传输要网络框架集成包。
    -->
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <!--
      宿主、日志与网络框架都由共享框架提供，不走 NuGet：
      网络框架集成包已经把它那一层带上了，再单独引一次会让两边各拿一份，
      而混用两套抽象层的问题在运行时才露出来。
    -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
