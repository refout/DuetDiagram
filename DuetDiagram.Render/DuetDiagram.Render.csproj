<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>DuetDiagram.Render</RootNamespace>
  </PropertyGroup>

  <!--
    渲染层：空间索引、视口剔除、绘制列表与文本度量。
    绘制列表本身是纯数据（不含界面框架类型、不含绘图库类型），
    引用 Core 与 Layout 是因为要把 IR 与布局结果翻译成绘制指令；
    引用 SkiaSharp 只为了量文本——节点尺寸由标签量出来，而那一步需要真实字体。
    画布控件不在这里，见 AGENTS.md 的差异表。
  -->

  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
    <!--
      原生库要按平台补齐。SkiaSharp 那个包的依赖清单里只有 Win32 与 macOS 两份，
      引用它的工程在 Windows 上因此能直接跑；Linux 上少一份，而这一层里
      位图导出、PDF 导出与文本测量都要碰原生库，缺了就是 DllNotFoundException。
      只在 Linux 上引：别的平台上引进来只会把用不上的 .so 拷进输出目录。
    -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DuetDiagram.Core\DuetDiagram.Core.csproj" />
    <ProjectReference Include="..\DuetDiagram.Layout\DuetDiagram.Layout.csproj" />
  </ItemGroup>

</Project>
