<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Phase 0 P0-01: restore source is pinned so that a machine-level nuget.config
    cannot silently change which feed resolved the exact versions in
    Directory.Packages.props.
  -->
  <packageSources>
    <clear />
    <add key="nuget-mirror" value="https://nuget.azure.cn/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
